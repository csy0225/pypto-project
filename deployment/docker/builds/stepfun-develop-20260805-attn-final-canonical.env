# Workload-derived Full/SWA attention canonical image.  The image contains
# only committed source and explicitly selects the 0162 A2A3 attention task
# profile; the eight per-stage attention overrides must remain absent.
# Build with:
#   bash build.sh builds/stepfun-develop-20260805-attn-final-canonical.env
IMAGE_TAG=stepfun-develop-20260805-attn-final-canonical
PYPTO_COMMIT=defa97c526fec7e8f032dbbfcc39c820add02bf7
PYPTO_LIB_COMMIT=91c7f46ee949045e2fce807276412b48d8121763
PTO_ISA_COMMIT=ecb6c303f797749f811a494742c3c08156aacabb
PTOAS_COMMIT=fc8c6caee561914b4fb991dfc8427bb63194269e
SIMPLER_COMMIT=e2efebcbd190302609c0775d2984f409f5f42c76
PTOAS_BIN_VER=v0.50
ATTN_TASK_PROFILE=a2a3
# This 17 GiB devbox has no swap. Keep both PyPTO and simpler runtime builds
# strictly serial; simpler's nested ThreadPools and cmake parallelism are
# bridged by Dockerfile.
BUILD_JOBS=1
VLLM_PATCH_BRANCH=csy/pypto-tail-mtp-integration
VLLM_PATCH_COMMIT=1b3e538c35999e62b6d24e0651b3a85b7d16c826
