# K8 selective persistent-window zeroing release spec.
#
# Source combination = the 2026-08-08 latest-source spec plus the two K8
# landing commits (nothing else moved):
#   pypto      8e92b468 -> 1c048a74   distributed_runner.py +174/-22
#                                     (reset trace + selective memset)
#   pypto-lib  27a43f6a -> cb96747e   decode_fwd.py +11/-7
#                                     (7 control buffers -> window prefix)
#
# Measured on 0162 before landing (source overlay, A/B/A double bracket):
#   whole-net BS1 ctx=65536 ITL p50  33.84 -> 32.08 ms  (-1.7455 ms / -5.16%)
#   _reset_persistent_domains body   2253  -> 518 us
#   hidden_sha256 567b206bb03d89f84020e1dddd61098a8f79f32f81b8f4fcf56443113e27f03e
#   tail token 14371  (byte-exact vs production baseline)
#
# No manifest/config digest is recorded here until this image is built and the
# 0162 image + performance gates pass.  A spec is not a publication claim.
#
# Build with (devbox that has docker; 0162 has no buildkit and no GitHub or
# proxy egress, so the build structurally cannot run there):
#   bash build.sh builds/stepfun-develop-20260811-k8-selective.env
IMAGE_TAG=stepfun-develop-20260811-k8-selective
BASE=hub.i.basemind.com/stepcast/vllm-pypto@sha256:3d6392588fe9fb6ce4f5852100667d24f09d70f262dbd0ebe6c45b380f49573a
PYPTO_COMMIT=1c048a744d5f63a8bce1ddb45dac8d1b7f458bb0
PYPTO_LIB_COMMIT=cb96747eb21f5f4932d6a24eddaa69c85d095ef6
PTO_ISA_COMMIT=ecb6c303f797749f811a494742c3c08156aacabb
PTOAS_COMMIT=fc8c6caee561914b4fb991dfc8427bb63194269e
SIMPLER_COMMIT=e2efebcbd190302609c0775d2984f409f5f42c76
PTOAS_BIN_VER=v0.50
PTOAS_BIN_SHA256=ba93fabeff6dc7fdcd2278a72fd1d4fd92cb2949faedbc83fa58e801bd5ff23b
PTOAS_BIN_ARCHIVE_SHA256=48049353e447ee9ec398731af33f9e903fd59b0cd0130f85e23bdebe347335e6
ATTN_TASK_PROFILE=a2a3
REQUIRE_L2_SWIMLANE_REUSE_DEP_GEN=1
# BUILD_JOBS is intentionally omitted; build.sh uses its validated default.
VLLM_PATCH_BRANCH=csy/pypto-tail-mtp-integration
VLLM_PATCH_COMMIT=1b3e538c35999e62b6d24e0651b3a85b7d16c826
