# Canonical workload-sized attention image built from the latest committed
# stepfun/develop tips.  The A2A3 profile is explicit and all per-stage
# attention overrides must remain absent.
#
# 0162 immutable qualification (BS1, per-request 64K):
#   manifest sha256:3eb694e0455749b370c2da441f04badb47f2752edb53f2cf4e6acb1fde125479
#   config   sha256:a6095ba550aa8207e66a10ad2e8923d120af957c9e014349d26915d7ba33d216
#   pin/credential/clean-tree/profile audit PASS
#   whole-net ITL 50x p50 39.612 ms; two-layer exact + DFX 8/8 ranks PASS
#
# Build with:
#   bash build.sh builds/stepfun-develop-20260806-attn-taskmajor-canonical.env
IMAGE_TAG=stepfun-develop-20260806-attn-taskmajor-canonical
BASE=hub.i.basemind.com/stepcast/vllm-pypto@sha256:3d6392588fe9fb6ce4f5852100667d24f09d70f262dbd0ebe6c45b380f49573a
PYPTO_COMMIT=8e92b46808f9f7c09b6431ad4691503f09c12ee5
PYPTO_LIB_COMMIT=c9af5790d5fe450e14fd43c88099b87539089d17
PTO_ISA_COMMIT=ecb6c303f797749f811a494742c3c08156aacabb
PTOAS_COMMIT=fc8c6caee561914b4fb991dfc8427bb63194269e
SIMPLER_COMMIT=e2efebcbd190302609c0775d2984f409f5f42c76
PTOAS_BIN_VER=v0.50
ATTN_TASK_PROFILE=a2a3
# This devbox has five CPUs and no swap.  Two jobs removes the obsolete
# single-job restriction without enabling unsafe nested full-host fan-out.
BUILD_JOBS=2
VLLM_PATCH_BRANCH=csy/pypto-tail-mtp-integration
VLLM_PATCH_COMMIT=1b3e538c35999e62b6d24e0651b3a85b7d16c826
